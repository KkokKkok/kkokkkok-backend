# Copy to deploy/.env (ignored). Never put real keys in this sample.
APP_API_KEY=replace-with-a-local-random-value
BACKEND_PORT=18081
# Path to the analysis repository containing its Dockerfile.
ANALYSIS_CONTEXT=../../KkokKkok-PoC
ANALYSIS_API_KEY=replace-with-a-local-server-key
ANALYSIS_VISION_STAGE_KEY=replace-with-a-local-stage-key
OPENAI_MODEL=

# Required only for the PostgreSQL overlay.
DB_PASSWORD=replace-with-a-local-database-password

# Existing private bucket, used only with compose.s3.yaml. No access keys in this file.
ASSET_S3_BUCKET=
AWS_REGION=ap-northeast-2
ASSET_S3_PREFIX=assets/
